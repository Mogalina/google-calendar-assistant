{
  "manifest_version": 3,
  "name": "Google Calendar Assistant",
  "description": "Google Calendar Assistant Chrome Extension",
  "version": "1.0.0",
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "host_permissions": [
    "*://calendar.google.com/*"
  ],
  "permissions": [
    "activeTab", 
    "scripting"
  ],
  "background": {
    "service_worker": "background.js" 
  },
  "content_scripts": [
    {
      "matches": [
        "*://calendar.google.com/*"
      ],
      "run_at": "document_start",
      "js": [
        "scripts/content.js",
        "components/assistant-button/assistantActionButton.js",
        "chat-panel/script/injectChatPanel.js",
        "chat-panel/script/app.js"
      ],
      "css": [
        "components/assistant-button/assistantActionButton.css",
        "chat-panel/style/index.css",
        "chat-panel/style/global.css"
      ]
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "chat-panel/*",
        "chat-panel/assets/images/*",
        "components/assistant-button/*",
        "components/assistant-button/**/*",
        "icons/*"
      ],
      "matches": [
        "*://calendar.google.com/*"
      ]
    }
  ]
}
