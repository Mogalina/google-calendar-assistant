{
  "manifest_version": 3,
  "name": "Google Calendar Assistant",
  "version": "1.0",
  "background": {
    "service_worker": "background.js" ,
    "type":"module"
  },
  "content_scripts": [
    {
      "matches": ["https://calendar.google.com/*"], 
      "js": ["scripts/content.js"]
    }
  ],
  "permissions": ["activeTab", "scripting"]
}
